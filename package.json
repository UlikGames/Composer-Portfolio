{
  "name": "composer-portfolio",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace web --",
    "build": "npm run build --workspaces --if-present",
    "check-types": "npm run check-types --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "deploy": "npx vercel@latest deploy",
    "deploy:prod": "npx vercel@latest deploy --prod"
  },
  "dependencies": {
    "@composer-portfolio/env": "*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@composer-portfolio/config": "*",
    "@types/node": "^26.2.0",
    "typescript": "~5.9.3"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": { "esbuild": true, "sharp": true }
}
